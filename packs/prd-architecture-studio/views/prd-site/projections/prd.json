{
 "overview": {
  "projectName": {
   "$first": {
    "$nodes": "Product",
    "$field": "$label"
   }
  },
  "author": {
   "$first": {
    "$nodes": "Role",
    "$where": {
     "attr.kind": "owner"
    },
    "$field": "$attr.holder"
   }
  },
  "date": {
   "$first": {
    "$nodes": "Product",
    "$field": "$as_of"
   }
  },
  "problem": {
   "$first": {
    "$nodes": "Product",
    "$field": "$attr.problem"
   }
  },
  "background": {
   "$first": {
    "$nodes": "Product",
    "$field": "$attr.background"
   }
  },
  "objectives": {
   "$nodes": "Objective",
   "$sort": "label",
   "$field": "$label"
  },
  "vision": {
   "$first": {
    "$nodes": "Product",
    "$field": "$attr.vision"
   }
  },
  "differentiator": {
   "$first": {
    "$nodes": "ValueProposition",
    "$field": "$attr.differentiator"
   }
  },
  "targetUsers": {
   "$first": {
    "$nodes": "Persona",
    "$where": {
     "attr.relationship": "target"
    },
    "$field": "$label"
   }
  },
  "criteria": {
   "$nodes": "SuccessCriterion",
   "$sort": "label",
   "$map": {
    "id": "$id",
    "text": "$label",
    "metric": {
     "$format": "{attr.metric}: target {attr.target} by {attr.due_on}"
    }
   }
  }
 },
 "portfolio": {
  "domain": {
   "$first": {
    "$nodes": "Product",
    "$field": "$attr.domain"
   }
  },
  "capability": {
   "$first": {
    "$nodes": "Capability",
    "$field": "$label"
   }
  },
  "valueStream": {
   "$first": {
    "$nodes": "Product",
    "$field": "$attr.value_stream"
   }
  },
  "position": {
   "$first": {
    "$nodes": "Product",
    "$field": "$attr.stage"
   }
  },
  "owners": {
   "$nodes": "Role",
   "$sort": "label",
   "$map": {
    "role": "$label",
    "name": "$attr.holder"
   }
  },
  "dependencies": {
   "$nodes": "ExternalSystem",
   "$sort": "label",
   "$map": {
    "id": "$id",
    "product": "$label",
    "direction": {
     "$const": "bidirectional"
    },
    "nature": "$summary",
    "status": "$status",
    "notes": {
     "$first": {
      "$out": "integrated_by",
      "$select": "$label"
     }
    }
   }
  },
  "objectives": {
   "$nodes": "Objective",
   "$sort": "label",
   "$map": {
    "id": "$id",
    "objective": "$label",
    "owner": {
     "$first": {
      "$out": "owned_by",
      "$select": "$label"
     }
    },
    "keyResults": {
     "$in": "measures",
     "$select": {
      "id": "$id",
      "kr": "$label",
      "contribution": "$attr.target",
      "metric": "$id"
     }
    }
   }
  }
 },
 "personas": {
  "$nodes": "Persona",
  "$sort": "label",
  "$map": {
   "id": "$id",
   "name": "$label",
   "role": "$summary",
   "tier": {
    "$format": "{attr.relationship}"
   },
   "situation": "$attr.need",
   "goal": "$attr.need",
   "obstacle": "",
   "solution": "",
   "successMetric": "",
   "permissions": "",
   "frequency": "",
   "volume": "",
   "authority": "",
   "collaboration": "",
   "touchpoints": "",
   "tools": "",
   "regulatory": "",
   "quote": ""
  }
 },
 "stakeholders": {
  "$nodes": "Role",
  "$sort": "label",
  "$map": {
   "id": "$id",
   "name": "$attr.holder",
   "role": "$label",
   "interest": "$attr.mandate",
   "govLink": ""
  }
 },
 "product": {
  "approach": {
   "$first": {
    "$nodes": "ValueProposition",
    "$field": "$attr.promise"
   }
  },
  "inScope": {
   "$nodes": "Feature",
   "$sort": "label",
   "$field": "$label"
  },
  "outScope": {
   "$const": []
  },
  "mvp": {
   "$nodes": "Release",
   "$where": {
    "attr.horizon": "mvp"
   },
   "$field": {
    "$format": "{label} ({attr.target_date})"
   }
  },
  "growth": {
   "$nodes": "Release",
   "$where": {
    "attr.horizon": "growth"
   },
   "$field": "$label"
  },
  "vision": {
   "$nodes": "Release",
   "$where": {
    "attr.horizon": "later"
   },
   "$field": "$label"
  }
 },
 "journeys": {
  "$nodes": "UserJourney",
  "$sort": "label",
  "$map": {
   "id": "$id",
   "title": "$label",
   "personaId": {
    "$first": {
     "$out": "intended_for",
     "$select": "$id"
    }
   },
   "opening": "$attr.trigger",
   "rising": "$summary",
   "climax": "",
   "resolution": "$attr.outcome",
   "capabilities": {
    "$in": "part_of",
    "$select": "$label"
   }
  }
 },
 "usecases": {
  "$nodes": "UseCase",
  "$sort": "label",
  "$map": {
   "id": "$id",
   "title": "$label",
   "journeyId": "",
   "primaryActor": {
    "$first": {
     "$out": "performed_by",
     "$select": "$id"
    }
   },
   "supportingActors": "",
   "trigger": "",
   "preconditions": "",
   "orchestration": {
    "$first": {
     "$out": "part_of",
     "$select": "$label"
    }
   },
   "repeatability": "$attr.readiness",
   "postconditions": "",
   "mainFlow": {
    "$out": "issues",
    "$select": "$label"
   },
   "extensions": {
    "$const": []
   },
   "terminalStates": {
    "$const": []
   },
   "frs": {
    "$out": "satisfies",
    "$select": "$id"
   },
   "workflow": "",
   "acceptance": {
    "$in": "exercises",
    "$select": {
     "title": "$label",
     "given": [
      "$attr.given"
     ],
     "when": [
      "$attr.when"
     ],
     "then": [
      "$attr.then"
     ]
    }
   }
  }
 },
 "specs": {
  "functional": {
   "$nodes": "Requirement",
   "$sort": "label",
   "$map": {
    "id": "$id",
    "area": "$attr.concerns",
    "text": "$label",
    "traceJ": "",
    "traceSC": "",
    "priority": "$attr.priority",
    "serves": {
     "$first": {
      "$out": "serves",
      "$select": "$id"
     }
    }
   },
   "$where": {
    "attr.kind": "functional"
   }
  },
  "nonfunctional": {
   "$nodes": "Requirement",
   "$sort": "label",
   "$map": {
    "id": "$id",
    "cat": "$attr.concerns",
    "text": "$label"
   },
   "$where": {
    "attr.kind": "non-functional"
   }
  },
  "policies": {
   "$nodes": "Policy",
   "$sort": "label",
   "$map": {
    "id": "$id",
    "name": "$label",
    "statement": "$summary",
    "traceFR": {
     "$first": {
      "$out": "applies_to",
      "$select": "$id"
     }
    }
   }
  }
 },
 "governance": {
  "$nodes": "Role",
  "$sort": "label",
  "$map": {
   "id": "$id",
   "item": "$attr.mandate",
   "type": {
    "$const": "Ownership"
   },
   "owner": "$label",
   "status": "$status",
   "notes": "$attr.holder"
  }
 },
 "risk": {
  "$nodes": "Risk",
  "$sort": "label",
  "$map": {
   "id": "$id",
   "title": "$label",
   "cat": "$attr.kind",
   "likelihood": "",
   "impact": {
    "$first": {
     "$out": "threatens",
     "$select": "$label"
    }
   },
   "mitigation": {
    "$first": {
     "$out": "mitigated_by",
     "$select": "$label"
    }
   },
   "owner": "$attr.state"
  }
 },
 "glossary": {
  "$nodes": "Term",
  "$sort": "label",
  "$map": {
   "id": "$id",
   "term": "$label",
   "definition": "$attr.definition"
  }
 }
}